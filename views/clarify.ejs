<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TradeLens - Clarify Experiment</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container py-5">

        <div class="text-center mb-5">
            <h1 class="fw-bold">TradeLens</h1>
            <p class="text-muted">
                Let's clarify your trading experiment
            </p>
        </div>

        <div class="card shadow-sm p-4 mx-auto" style="max-width: 800px;">

            <h3 class="mb-3">
                A few details are missing
            </h3>

            <p class="text-muted">
                I understood your research question, but I need a few
                details before defining the experiment.
            </p>

            <div class="alert alert-light border mb-4">
                <strong>Your question:</strong>
                <%= experiment.question %>
            </div>

            <form action="/clarify" method="POST">

                <!-- Keep the AI-generated information for the final experiment -->

                <input
                    type="hidden"
                    name="question"
                    value="<%= experiment.question %>"
                >

                <input
                    type="hidden"
                    name="instrument"
                    value="<%= experiment.instrument %>"
                >

                <input
                    type="hidden"
                    name="entryCondition"
                    value="<%= experiment.entryCondition %>"
                >

                <input
                    type="hidden"
                    name="filters"
                    value="<%= experiment.filters.join('|') %>"
                >

                <input
                    type="hidden"
                    name="researchQuestion"
                    value="<%= experiment.researchQuestion %>"
                >

<% if (!experiment.missingInformation.includes("Timeframe")) { %>

    <input
        type="hidden"
        name="timeframe"
        value="<%= experiment.timeframe || '' %>"
    >

<% } %>


<% if (!experiment.missingInformation.includes("Exit condition")) { %>

    <input
        type="hidden"
        name="exitCondition"
        value="<%= experiment.exitCondition || '' %>"
    >

<% } %>


<% if (!experiment.missingInformation.includes("Holding period")) { %>

    <input
        type="hidden"
        name="holdingPeriod"
        value="<%= experiment.holdingPeriod || '' %>"
    >

<% } %>

<% if (experiment.missingInformation.includes("Timeframe")) { %>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            What timeframe should be used?
                        </label>

                        <select
                            name="timeframe"
                            class="form-select"
                            required
                        >
                            <option value="">Select timeframe</option>
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Intraday">Intraday</option>
                        </select>
                    </div>

                <% } %>


                <% if (experiment.missingInformation.includes("Exit condition")) { %>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            What should be the exit condition?
                        </label>

                        <input
                            type="text"
                            name="exitCondition"
                            class="form-control"
                            placeholder="Example: Sell when price recovers 1%"
                            required
                        >
                    </div>

                <% } %>


                <% if (experiment.missingInformation.includes("Holding period")) { %>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            How long should the position be held?
                        </label>

                        <input
                            type="text"
                            name="holdingPeriod"
                            class="form-control"
                            placeholder="Example: 5 trading days"
                            required
                        >
                    </div>

                <% } %>


                <button type="submit" class="btn btn-dark w-100">
                    Continue
                </button>

            </form>

        </div>

    </div>

</body>
</html>