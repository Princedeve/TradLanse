<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TradeLens - <%= title %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container py-5">

        <div class="card shadow-sm p-5 mx-auto text-center"
             style="max-width: 650px;">

            <div class="mb-4">
                <span
                    class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle"
                    style="width: 70px; height: 70px;"
                >
                    <span style="font-size: 32px;">⚠️</span>
                </span>
            </div>

            <h2 class="fw-bold mb-3">
                <%= title %>
            </h2>

            <p class="text-muted mb-4">
                <%= message %>
            </p>

            <div class="alert alert-light border text-start mb-4">

                <strong>What happened?</strong>

                <p class="mb-0 mt-2 text-muted">
                    TradeLens uses an AI service to understand your
                    trading research question. The AI service is
                    temporarily unavailable for this request.
                </p>

            </div>

            <div class="d-flex gap-2 justify-content-center">

                <a href="/" class="btn btn-dark">
                    Try Again
                </a>

            </div>

        </div>

    </div>

</body>

</html>