<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TradeLens - Experiment</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">TradeLens</h1>
        <p class="text-muted">
            AI Trading Research Assistant
        </p>
    </div>


    <!-- Experiment Card -->
    <div class="card shadow-sm p-4 mx-auto" style="max-width: 900px;">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Trading Experiment</h2>
                <p class="text-muted mb-0">
                    Structured from your research question
                </p>
            </div>

            <span class="badge text-bg-success">
                Ready
            </span>
        </div>


        <!-- Original Question -->
        <div class="mb-4">
            <h6 class="text-muted">Original Question</h6>

            <p class="fs-5 mb-0">
                <%= experiment.question %>
            </p>
        </div>


        <hr>


        <!-- Experiment Details -->
        <div class="row g-4 mt-2">

            <!-- Instrument -->
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <small class="text-muted">
                        Instrument
                    </small>

                    <h5 class="mt-2 mb-0">
                        <%= experiment.instrument || "Not specified" %>
                    </h5>
                </div>
            </div>


            <!-- Timeframe -->
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <small class="text-muted">
                        Timeframe
                    </small>

                    <h5 class="mt-2 mb-0">
                        <%= experiment.timeframe || "Not specified" %>
                    </h5>
                </div>
            </div>


            <!-- Entry Condition -->
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <small class="text-muted">
                        Entry Condition
                    </small>

                    <p class="mt-2 mb-0">
                        <%= experiment.entryCondition || "Not specified" %>
                    </p>
                </div>
            </div>


            <!-- Exit Condition -->
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <small class="text-muted">
                        Exit Condition
                    </small>

                    <p class="mt-2 mb-0">
                        <%= experiment.exitCondition || "Not specified" %>
                    </p>
                </div>
            </div>


            <!-- Holding Period -->
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <small class="text-muted">
                        Holding Period
                    </small>

                    <p class="mt-2 mb-0">
                        <%= experiment.holdingPeriod || "Not specified" %>
                    </p>
                </div>
            </div>


            <!-- Filters -->
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <small class="text-muted">
                        Filters
                    </small>

                    <div class="mt-2">

                        <% if (experiment.filters && experiment.filters.length > 0) { %>

                            <% experiment.filters.forEach(filter => { %>
                                <span class="badge text-bg-light border me-1">
                                    <%= filter %>
                                </span>
                            <% }) %>

                        <% } else { %>

                            <span class="text-muted">
                                No filters specified
                            </span>

                        <% } %>

                    </div>
                </div>
            </div>

        </div>


        <!-- Research Question -->
        <div class="mt-4 p-4 bg-light rounded">

            <h6 class="text-muted">
                What are we trying to find out?
            </h6>

            <p class="mb-0 fs-5">
                <%= experiment.researchQuestion || "Not specified" %>
            </p>

        </div>


        <!-- Actions -->
        <div class="d-flex gap-2 mt-4">

            <a href="/" class="btn btn-outline-dark">
                Ask Another Question
            </a>

        </div>

    </div>

</div>

</body>
</html>